// Prisma schema لمنصة "سيرتي".
//
// ملاحظة مهمة للنشر:
// أثناء التطوير نستخدم SQLite (provider = "sqlite").
// قبل النشر على منصات serverless مثل Vercel — التي لا تحافظ على ملف SQLite
// بين الطلبات — بدّل provider إلى "postgresql" وحدّث DATABASE_URL إلى
// قاعدة Postgres (مثل Neon أو Supabase). الموديل أدناه متوافق مع كليهما.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  status          String   @default("pending") // pending | paid | failed
  amount          Int // بالسنت
  currency        String   @default("usd")
  templateId      String
  language        String // "ar" | "en"
  cvData          String // JSON نصّي يحوي كامل بيانات السيرة الذاتية
  customerName    String? // مستخرج من cvData لسهولة العرض في لوحة الأدمن
  customerEmail   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
