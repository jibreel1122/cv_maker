// Prisma schema for the CV Maker platform.
//
// Deployment note:
//   During development we use SQLite (provider = "sqlite").
//   Before deploying to a serverless host (e.g. Vercel) — which does not keep
//   the SQLite file between requests — switch `provider` to "postgresql" and
//   point DATABASE_URL at a managed Postgres database (Neon / Supabase).
//   The models below are compatible with both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Roles: USER (default), ADMIN, OWNER.
//   - USER  : can create and manage their own CVs.
//   - ADMIN : can view all users and CVs, and promote/demote between USER/ADMIN.
//   - OWNER : full control, including granting/revoking ADMIN and OWNER.
// Stored as a plain string so the schema stays portable across SQLite/Postgres.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for accounts created purely via Google/Apple
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  cvs      CV[]

  @@index([role])
}

// NextAuth adapter models -----------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// CVs ------------------------------------------------------------------------

model CV {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("Untitled CV")
  templateId String   @default("classic")
  data       String // JSON string holding the full CV contents
  fullName   String? // denormalised from data for quick listing in the admin panel
  jobTitle   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

// Audit log -------------------------------------------------------------------
// `metadata` holds a JSON-encoded string (e.g. { ip, email, oldRole, newRole }).
// We use String rather than Prisma's Json type so the column — and `contains`
// filtering on it — works on both SQLite and Postgres.

model AuditLog {
  id        String   @id @default(cuid())
  userId    String? // actor or subject; null for events with no known user (e.g. failed login)
  action    String // LOGIN_FAILED | LOGIN_SUCCESS | DELETE_ACCOUNT | ROLE_CHANGED | USER_DELETED_BY_ADMIN | EMAIL_VERIFIED
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
