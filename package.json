{
  "name": "bornat-cv-maker",
  "version": "2.0.0",
  "private": true,
  "description": "Bornat CV Maker — free bilingual (Arabic/English) ATS-friendly CV builder with roles and an admin dashboard.",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "db:setup": "prisma generate && prisma db push && node prisma/seed.js",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.7.1",
    "lucide-react": "^0.460.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.11",
    "puppeteer": "^23.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "resend": "^6.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "vitest": "^2.1.9"
  }
}
