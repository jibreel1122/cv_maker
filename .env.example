# ============================================================================
# CV Maker — environment variables
#
# 1) Copy this file to `.env`  (NOT .env.local — Prisma's CLI reads `.env`):
#        cp .env.example .env
# 2) Fill in the Supabase values below.
# 3) Run:  npm run db:setup     (creates tables + seeds the owner/demo accounts)
# 4) Run:  npm run dev
#
# `.env` is gitignored — your secrets stay local.
# ============================================================================

# ---- Database: Supabase (PostgreSQL) ---------------------------------------
# In the Supabase dashboard:  Project → Settings → Database → "Connection string"
#
#   DATABASE_URL = the "Connection pooling" string (Transaction mode, port 6543).
#                  The app uses this at runtime. Keep the `?pgbouncer=true` flag.
#   DIRECT_URL   = the "Direct connection" string (Session mode, port 5432).
#                  Prisma uses this for `db push` / migrations.
#
# Replace [PASSWORD] with your database password and [PROJECT-REF]/[REGION]
# with the values Supabase shows you.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---- Auth ------------------------------------------------------------------
# Signs sessions + email-verification tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate_a_strong_random_string_here"
NEXTAUTH_URL="http://localhost:3000"

# ---- Email verification (Resend) -------------------------------------------
# Verification only runs when RESEND_API_KEY is set. Without it, new accounts are
# created already verified so nobody is locked out by an email that can never
# arrive — leave it unset for local development.
#
#   1. Sign up at resend.com (free tier) → API Keys → create one.
#   2. EMAIL_FROM must be an address on a domain you verified in Resend.
#      `onboarding@resend.dev` works without a domain, but it can ONLY deliver
#      to the email address that owns the Resend account — fine for testing,
#      not for real users.
#   3. NEXTAUTH_URL must be the public origin; the verification link is built
#      from it.
#
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="CV Maker <onboarding@resend.dev>"

# Force verification off even when RESEND_API_KEY is set (new accounts are
# created pre-verified). Any value other than "false" leaves it enabled.
# ENABLE_EMAIL_VERIFICATION="false"

# ---- Owner / admin seed (optional — these are the defaults) -----------------
# OWNER_EMAIL=jibreelebornat@gmail.com
# OWNER_PASSWORD=Miskbo123
# OWNER_NAME=Jibreel Bornat

# ---- Supabase JS client keys (OPTIONAL — NOT required by this app) ----------
# This app talks to Postgres directly through Prisma, so the anon key is NOT
# needed. Only set these if you later add the @supabase/supabase-js client
# (Auth/Storage/Realtime). Find them in: Project → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
