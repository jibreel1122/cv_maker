# ============================================================================
# CV Maker — environment variables
#
# The app runs 100% LOCALLY with NO external services, keys, or accounts.
# You do not need to set anything to start: `npm install && npm run dev` works
# out of the box (DATABASE_URL ships in the committed `.env`, and a dev
# NEXTAUTH_SECRET fallback is used automatically in development).
#
# To customise, copy this file to `.env.local` and set any of the below.
# ============================================================================

# Local SQLite database file (already provided in the committed `.env`).
DATABASE_URL="file:./dev.db"

# Session/token signing secret. Optional in development (a dev fallback is
# used). REQUIRED in production — generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Base URL of the app (used to build verification links). Defaults to
# http://localhost:3000 when unset.
NEXTAUTH_URL=http://localhost:3000

# Optional: override the seeded owner account (defaults shown).
# OWNER_EMAIL=jibreelebornat@gmail.com
# OWNER_PASSWORD=Miskbo123
# OWNER_NAME=Jibreel Ebornat
