# ============================================================================
# CV Maker — environment variables
#
# 1) Copy this file to `.env`  (NOT .env.local — Prisma's CLI reads `.env`):
#        cp .env.example .env
# 2) Fill in the Supabase values below.
# 3) Run:  npm run db:setup     (creates tables + seeds the owner/demo accounts)
# 4) Run:  npm run dev
#
# `.env` is gitignored — your secrets stay local.
# ============================================================================

# ---- Database: Supabase (PostgreSQL) ---------------------------------------
# In the Supabase dashboard:  Project → Settings → Database → "Connection string"
#
#   DATABASE_URL = the "Connection pooling" string (Transaction mode, port 6543).
#                  The app uses this at runtime. Keep the `?pgbouncer=true` flag.
#   DIRECT_URL   = the "Direct connection" string (Session mode, port 5432).
#                  Prisma uses this for `db push` / migrations.
#
# Replace [PASSWORD] with your database password and [PROJECT-REF]/[REGION]
# with the values Supabase shows you.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---- Proxying / rate limiting ----------------------------------------------
# How many reverse proxies sit in front of this app. `x-forwarded-for` is a list
# the CLIENT can seed, so only the entries your own proxies appended (counting
# from the right) can be trusted — reading the left-most value hands every
# request a fresh rate-limit bucket.
#
#   0  no proxy, direct to Node — ignore x-forwarded-for entirely
#   1  one load balancer / reverse proxy (default: Render, Railway, Fly, nginx)
#   2  two hops, e.g. Cloudflare in front of a platform load balancer
TRUSTED_PROXY_HOPS="1"

# ---- Auth ------------------------------------------------------------------
# Signs sessions + email-verification tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate_a_strong_random_string_here"
NEXTAUTH_URL="http://localhost:3000"

# ---- Email verification (Resend) -------------------------------------------
# Verification is OPT-IN and off by default. It only runs when BOTH
# ENABLE_EMAIL_VERIFICATION="true" AND RESEND_API_KEY are set.
#
# Leave it off until your custom domain's DNS is fully verified in Resend.
# While it is off, new accounts are created already verified and can sign in
# immediately — nobody is locked out waiting for an email that cannot arrive.
#
#   "false" / unset  ->  verification off, accounts usable immediately (default)
#   "true"           ->  verification on, requires a working RESEND_API_KEY
ENABLE_EMAIL_VERIFICATION="false"

# Your Resend API key: resend.com -> API Keys.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# The From address. Must be on a domain you have verified in Resend
# (resend.com -> Domains -> Add Domain, then add the DKIM/SPF records).
# Replace `yourdomain.com` with your real domain before enabling verification.
EMAIL_FROM="CV Maker <noreply@yourdomain.com>"

# NOTE on `onboarding@resend.dev`: Resend's shared test sender works without a
# domain, but it can ONLY deliver to the email address that owns your Resend
# account. Every other recipient is rejected with a 403. Do not use it as
# EMAIL_FROM for real users — the app treats that rejection as a configuration
# problem and verifies the account automatically so signup still works, but no
# email is actually sent.

# ---- Owner / admin seed (REQUIRED for `npm run db:seed`) --------------------
# No defaults: a fallback password would create an admin account with publicly
# known credentials on every deployment. Generate a strong one:
#   openssl rand -base64 18
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD="generate_a_strong_password_min_12_chars"
OWNER_NAME="Owner"

# Create the local demo accounts too (never do this in production).
# SEED_DEMO_USERS="true" 

# ---- Supabase JS client keys (OPTIONAL — NOT required by this app) ----------
# This app talks to Postgres directly through Prisma, so the anon key is NOT
# needed. Only set these if you later add the @supabase/supabase-js client
# (Auth/Storage/Realtime). Find them in: Project → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
