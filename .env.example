# ============================================================================
# CV Maker — environment variables
# Copy this file to .env.local and fill in the values for local development.
# ============================================================================

# ---- Database --------------------------------------------------------------
# Local development uses SQLite. For production (Vercel etc.) switch the
# `provider` in prisma/schema.prisma to "postgresql" and use a Postgres URL.
DATABASE_URL="file:./dev.db"

# ---- NextAuth (authentication) ---------------------------------------------
# A long random string used to sign session tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# The canonical URL of the app (no trailing slash).
NEXTAUTH_URL=http://localhost:3000

# ---- Google OAuth (optional) -----------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Apple OAuth (optional) ------------------------------------------------
# From your Apple Developer account (Sign in with Apple).
# APPLE_CLIENT_SECRET is the signed JWT you generate from your private key.
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/apple
APPLE_ID=
APPLE_CLIENT_SECRET=

# ---- Owner / admin account (seeded into the database) ----------------------
# Used by `npm run db:seed` to create the first OWNER account.
# Keep the real password out of version control — put it in .env.local only.
OWNER_EMAIL=jibreelebornat@gmail.com
OWNER_PASSWORD=change-me-in-.env.local
OWNER_NAME=Jibreel Ebornat
