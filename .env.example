# ============================================================================
# CV Maker — environment variables
# Copy this file to .env.local and fill in the values. NO real secrets here.
# ============================================================================

# ---- NextAuth (authentication) ---------------------------------------------
# A long random string used to sign session and verification tokens.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=generate_a_strong_random_string_here
NEXTAUTH_URL=http://localhost:3000

# ---- Database --------------------------------------------------------------
# Local dev uses SQLite. For production switch the provider in
# prisma/schema.prisma to "postgresql" and use a Postgres URL.
DATABASE_URL=file:./dev.db

# ---- Google OAuth (optional) -----------------------------------------------
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Apple OAuth (optional) ------------------------------------------------
# APPLE_CLIENT_SECRET is the signed client-secret JWT from your Apple account.
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ---- SMTP (email verification) ---------------------------------------------
# When unset, verification links are printed to the server console instead of
# being emailed (handy for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional "from" address (defaults to SMTP_USER):
SMTP_FROM=

# ---- Owner / admin account (seeded into the database) ----------------------
# Used by `npm run db:seed` to create the first OWNER account.
# Keep the real password out of version control — put it in .env.local only.
OWNER_EMAIL=jibreelebornat@gmail.com
OWNER_PASSWORD=change-me-in-.env.local
OWNER_NAME=Jibreel Ebornat
