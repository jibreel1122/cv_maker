# env
# NOTE: `.env` is intentionally committed — it holds only the non-secret local
# SQLite path (DATABASE_URL) so the app runs zero-config after a fresh clone.
# Real secrets/overrides go in `.env.local`, which stays ignored.
.env.local
.env*.local

